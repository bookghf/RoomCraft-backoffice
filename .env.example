# Where the Go API runs (server-side only; the browser never calls it directly).
# Deployed UAT API. For a local API (roomcraft-api docker compose) use http://localhost:8080
API_URL=https://uat-api-service-3d.apdigital.ai

# Vercel Blob store for catalog 3D model uploads. Set automatically when a Blob store is connected
# to this Vercel project; for local dev run `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
